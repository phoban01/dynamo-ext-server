// The server applies a bind with no rv condition and no holder check.
// Two clusters can then take the same device. Spec 5.3.
module unconditional_bind {
  import solas(CFG = {
    clusters: Set("a", "b"),
    devices: Set("d1", "d2"),
    claims: Set("a1", "a2", "b1"),
    owner: Map("a1" -> "a", "a2" -> "a", "b1" -> "b"),
    clock0: Map("a" -> 0, "b" -> 1000),
    D: 30,
    M: 6,
    tick: 10,
    drift: 1,
    unconditionalBind: true,
    membersFirst: false,
    adoptAnyUid: false,
  }).* from "../solas"
}
