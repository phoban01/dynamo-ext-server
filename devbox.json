{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.26",
    "nodejs@22",
    "quint@0.32.0",
    "jdk17@latest",
    "kind@latest",
    "kubectl@latest",
    "awscli2@latest",
    "rustup@latest",
    "golangci-lint@latest",
    "util-linux@latest"
  ],
  "env": {
    "JVM_ARGS": "-Xmx3g",
    "JAVA_TOOL_OPTIONS": "-Xmx3g",
    "GOFLAGS": "-p=4",
    "SIM_SHARDS": "4"
  },
  "shell": {
    "scripts": {
      "test": "scripts/test.sh",
      "sim-gate": "scripts/sim-gate.sh",
      "e2e": "scripts/e2e.sh",
      "verify": [
        "scripts/test.sh",
        "scripts/quint-check.sh"
      ]
    }
  }
}
