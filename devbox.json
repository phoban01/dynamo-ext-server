{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "go": "1.26",
    "nodejs": "22",
    "quint": "0.32.0",
    "jdk17": "latest",
    "k3d": "5.9.0",
    "kubectl": "latest",
    "awscli2": "latest",
    "rustup": "latest",
    "golangci-lint": "latest",
    "util-linux": "latest",
    "pkg-config": "latest",
    "openssl": {
      "version": "latest",
      "outputs": ["out", "dev"]
    },
    "etcd": "3.6.14"
  },
  "env": {
    "JVM_ARGS": "-Xmx3g",
    "JAVA_TOOL_OPTIONS": "-Xmx3g",
    "GOFLAGS": "-p=4",
    "SIM_SHARDS": "4",
    "CARGO_BUILD_JOBS": "4",
    "RUSTUP_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/rustup",
    "CARGO_HOME": "$DEVBOX_PROJECT_ROOT/.devbox/cargo",
    "PATH": "$DEVBOX_PROJECT_ROOT/.devbox/cargo/bin:$PATH"
  },
  "shell": {
    "scripts": {
      "test": "scripts/test.sh",
      "sim-gate": "scripts/sim-gate.sh",
      "e2e": "scripts/e2e.sh",
      "smoke": "scripts/smoke.sh",
      "mbt": "scripts/mbt.sh",
      "pivot-smoke": "scripts/pivot-smoke.sh",
      "demo": "demo/k3d/demo.sh",
      "demo-down": "demo/k3d/down.sh",
      "codegen": "hack/update-codegen.sh",
      "image": "scripts/images.sh",
      "duvet-install": "scripts/duvet-install.sh",
      "duvet": "rm -rf .duvet/requirements && duvet report --ci",
      "duvet-report": "rm -rf .duvet/requirements && duvet report",
      "verify": [
        "hack/verify-codegen.sh",
        "scripts/test.sh",
        "scripts/quint-check.sh",
        "scripts/mbt.sh",
        "rm -rf .duvet/requirements && duvet report --ci"
      ]
    }
  }
}
